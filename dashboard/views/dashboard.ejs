<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="<%= bot.avatar %>">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl" crossorigin="anonymous">
    <link rel="stylesheet" href="/index.css">
    <title>Dashboard | <%= websiteInfo.name %></title>
    <link rel="stylesheet" href="/panel-refresh.css">
  </head>
  <body>
    <%- include('header'); -%>

    <section class="dashboard-page">
      <div class="head">
        <h1>Dashboard de Servidores</h1>
      </div>
      <p class="dashboard-intro">
        Gerencie configurações por guild. Apenas usuários com permissão <b>Gerenciar Servidor</b> podem editar.
      </p>

      <% if (user && user.id) { %>
        <% const manageableGuilds = user.guilds
          .filter((guild) => {
            const guildPerms = BigInt(guild.permissions_new || 0);
            const MANAGE_GUILD = 0x20n;
            return (guildPerms & MANAGE_GUILD) === MANAGE_GUILD;
          })
          .sort((a, b) => {
            const inA = bot.guilds.has(a.id) ? 1 : 0;
            const inB = bot.guilds.has(b.id) ? 1 : 0;
            return inB - inA;
          });
        %>

        <% if (manageableGuilds.length > 0) { %>
          <div class="server-toolbar" aria-label="Buscar e filtrar servidores">
            <label class="server-search" for="server-search-input">
              <i class="fas fa-search" aria-hidden="true"></i>
              <input id="server-search-input" type="search" autocomplete="off" placeholder="Buscar servidor pelo nome" aria-controls="server-grid">
            </label>
            <div class="server-filters" role="group" aria-label="Filtrar servidores">
              <button type="button" class="server-filter is-active" data-server-filter="all" aria-pressed="true">Todos <span><%= manageableGuilds.length %></span></button>
              <button type="button" class="server-filter" data-server-filter="online" aria-pressed="false"><i class="fas fa-check-circle" aria-hidden="true"></i> Bot online</button>
              <button type="button" class="server-filter" data-server-filter="missing" aria-pressed="false"><i class="fas fa-plus-circle" aria-hidden="true"></i> Bot não adicionado</button>
            </div>
          </div>
          <p class="server-results" id="server-results" aria-live="polite"><%= manageableGuilds.length %> servidores encontrados</p>
          <div class="row g-3 server-grid" id="server-grid">
            <% manageableGuilds.forEach((guild) => {
              const guildIcon = guild.icon
                ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.webp?size=512`
                : `https://cdn.discordapp.com/embed/avatars/0.png`;
              const onServer = bot.guilds.has(guild.id);
              const botGuild = onServer ? bot.guilds.get(guild.id) : null;
              const memberCount = botGuild ? botGuild.memberCount : (guild.memberCount || guild.members?.cache?.size || 'N/A');
            %>
              <div class="col-12 col-sm-6 col-xl-4 server-grid-item" data-server-card data-server-name="<%= guild.name.toLowerCase() %>" data-bot-state="<%= onServer ? 'online' : 'missing' %>">
                <article class="card text-white bg-dark server-card">
                  <div class="card-body">
                    <div class="server-identity">
                      <img src="<%= guildIcon %>" class="server-avatar" alt="Ícone de <%= guild.name %>" loading="lazy">
                      <div class="server-identity-copy">
                        <h5 class="card-title"><%= guild.name %></h5>
                        <span class="status-pill <%= onServer ? 'status-pill-ok' : 'status-pill-warn' %>">
                          <i class="fas <%= onServer ? 'fa-check-circle' : 'fa-plus-circle' %>" aria-hidden="true"></i>
                          <%= onServer ? 'Bot online' : 'Bot não adicionado' %>
                        </span>
                      </div>
                    </div>
                    <% if (onServer) { %><p class="server-members"><i class="fas fa-users" aria-hidden="true"></i> <%= memberCount %> membros</p><% } %>


                    <% if (onServer) { %>
                      <p class="card-text">
                        Edite as configurações de <b><%= guild.name %></b> pelo painel.
                      </p>
                      <div class="card-actions">
                        <a href="/dashboard/<%- guild.id %>" class="btn-modern btn-modern-primary">
                          <i class="fas fa-cogs"></i>
                          <span>Configurações</span>
                        </a>
                        <a href="/dashboard/<%- guild.id %>/tickets" class="btn-modern btn-modern-secondary server-secondary-action">
                          <i class="fas fa-ticket-alt"></i>
                          <span>Tickets</span>
                        </a>
                        <a href="/dashboard/<%- guild.id %>/automod" class="btn-modern btn-modern-secondary server-secondary-action">
                          <i class="fas fa-shield-alt"></i>
                          <span>AutoMod</span>
                        </a>
                      </div>
                    <% } else { %>
                      <p class="card-text">
                        O bot ainda não está neste servidor. Adicione para liberar o painel completo.
                      </p>
                      <div class="card-actions">
                        <a
                          href="<%= `https://discord.com/oauth2/authorize?client_id=${bot.id}&scope=bot%20applications.commands&guild_id=${guild.id}&response_type=code&redirect_uri=${encodeURIComponent(`${callback}`)}` %>"
                          class="btn-modern btn-modern-success"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <i class="fas fa-plus"></i>
                          <span>Adicionar Bot</span>
                        </a>
                      </div>
                    <% } %>
                  </div>
                </article>
              </div>
            <% }); %>
          </div>
          <div class="server-no-results" id="server-no-results" hidden>Nenhum servidor corresponde à busca e ao filtro selecionados.</div>
        <% } else { %>
          <div class="hero-card dashboard-empty-card">
            <h5 style="margin-top:0;">Nenhum servidor disponível</h5>
            <p class="subtext" style="text-align:left; margin: 10px 0 0;">
              Não foi encontrado nenhum servidor com permissão de <b>Gerenciar Servidor</b> na sua conta.
            </p>
          </div>
        <% } %>
      <% } else { %>
        <div class="hero-card dashboard-empty-card">
          <h5 style="margin-top:0;">Login necessário</h5>
<p class="subtext" style="text-align:left; margin: 10px 0 0;">
              Entre com sua conta Discord para acessar os servidores disponíveis no painel.
            </p>
          <div class="hero-actions">
            <a class="btn-modern btn-modern-primary" href="/login">Fazer login</a>
          </div>
        </div>
      <% } %>
    </section>
    <button class="back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'});">↑</button>
    <%- include('footer'); -%>

    <script>
      (() => {
        const input = document.getElementById('server-search-input');
        const cards = [...document.querySelectorAll('[data-server-card]')];
        const filters = [...document.querySelectorAll('[data-server-filter]')];
        const results = document.getElementById('server-results');
        const empty = document.getElementById('server-no-results');
        let activeFilter = 'all';
        const update = () => {
          const query = (input?.value || '').trim().toLocaleLowerCase('pt-BR');
          let visible = 0;
          cards.forEach((card) => {
            const matches = card.dataset.serverName.includes(query) && (activeFilter === 'all' || card.dataset.botState === activeFilter);
            card.hidden = !matches;
            if (matches) visible += 1;
          });
          if (results) results.textContent = `${visible} ${visible === 1 ? 'servidor encontrado' : 'servidores encontrados'}`;
          if (empty) empty.hidden = visible !== 0;
        };
        input?.addEventListener('input', update);
        filters.forEach((button) => button.addEventListener('click', () => {
          activeFilter = button.dataset.serverFilter;
          filters.forEach((filter) => {
            const selected = filter === button;
            filter.classList.toggle('is-active', selected);
            filter.setAttribute('aria-pressed', String(selected));
          });
          update();
        }));
      })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/js/bootstrap.bundle.min.js" integrity="sha384-b5kHyXgcpbZJO/tY9Ul7kGkf1S0CWuKcCD38l8YkeH8z8QjE0GmW1gYU5S9FOnJ0" crossorigin="anonymous"></script>
  </body>
</html>
