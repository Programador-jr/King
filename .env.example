# Discord bot credentials
TOKEN=YOUR_DISCORD_BOT_TOKEN

# MongoDB connection (required)
MONGO_URI=mongodb://127.0.0.1:27017/king
DNS_RESULT_ORDER=ipv4first

# Lavalink connection (required for music)
LAVALINK_LOCAL=true
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_SECURE=false
LAVALINK_PASSWORD=CHANGE_ME_TO_MATCH_YOUR_LAVALINK_PASSWORD

# Dashboard OAuth (optional; leave blank to disable the dashboard)
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
DASHBOARD_DOMAIN=http://localhost:5000
DASHBOARD_CALLBACK=http://localhost:5000/callback
DASHBOARD_SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DASHBOARD_TRUST_PROXY=0
DASHBOARD_PORT=5000

# Optional integrations
SPOTIFY_API_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
VAGALUME_API_KEY=
TOPGG_WEBHOOK_AUTH=

NODE_ENV=development
